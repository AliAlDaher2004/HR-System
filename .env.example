# ==============================================================================
# HR & PAYROLL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Project & API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Database Connection String (Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Storage Buckets
SUPABASE_DOCUMENTS_BUCKET=employee-documents
SUPABASE_CONTRACTS_BUCKET=contracts
SUPABASE_LEAVE_BUCKET=leave-attachments
SUPABASE_PAYSLIPS_BUCKET=payslips

# First Admin Provisioning (Used during initial setup/seed only)
# In production, these MUST be explicitly provided and will NOT fall back to defaults.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=

# Node Environment
NODE_ENV=development
